# Required. JSON is portable across Windows drive letters and Unix paths.
LOCAL_HARNESS_ROOTS=["C:\\Users\\you\\source","D:\\work"]

# Optional read-only memory root. Must be absolute and separate from workspace roots.
# When using Codex memory, only the canonical ~/.codex/memories path is accepted.
LOCAL_HARNESS_MEMORY_ROOT=

# Optional comma-separated additions to the default executable allowlist.
LOCAL_HARNESS_ALLOWED_COMMANDS=

# Optional comma-separated environment variable names forwarded to child processes.
LOCAL_HARNESS_ENV_ALLOWLIST=

# Optional limits.
LOCAL_HARNESS_DEFAULT_TIMEOUT_MS=120000
LOCAL_HARNESS_MAX_TIMEOUT_MS=300000
LOCAL_HARNESS_MAX_OUTPUT_BYTES=1048576
LOCAL_HARNESS_MAX_FILE_BYTES=1048576

# Optional audit log location. Defaults to the operating-system temp directory.
LOCAL_HARNESS_AUDIT_LOG=

# Disabled by default. Set true only when UNC roots are intentional.
LOCAL_HARNESS_ALLOW_UNC=false

# Optional Google OAuth protection. Disabled keeps the existing stdio transport.
# When enabled, the harness serves MCP over Streamable HTTP at /mcp.
LOCAL_HARNESS_AUTH_ENABLED=false

# Required when authentication is enabled. Exact, case-insensitive email whitelist.
LOCAL_HARNESS_AUTH_WHITELIST=you@example.com,teammate@example.com

# Required Google OAuth web application credentials when authentication is enabled.
LOCAL_HARNESS_GOOGLE_CLIENT_ID=
LOCAL_HARNESS_GOOGLE_CLIENT_SECRET=

# Optional pre-registered OAuth client for ChatGPT's User-Defined OAuth Client mode.
# Set REDIRECT_URIS to the exact Callback URL shown by ChatGPT.
# If CLIENT_SECRET is set, choose client_secret_post in ChatGPT; otherwise choose none.
LOCAL_HARNESS_OAUTH_CLIENT_ID=
LOCAL_HARNESS_OAUTH_CLIENT_SECRET=
LOCAL_HARNESS_OAUTH_REDIRECT_URIS=

# Public/origin URL used for OAuth discovery and the Google callback.
# Register <this value>/oauth/google/callback as an authorized Google redirect URI.
LOCAL_HARNESS_AUTH_BASE_URL=http://127.0.0.1:3000

# HTTP bind used only when authentication is enabled.
LOCAL_HARNESS_HTTP_HOST=127.0.0.1
LOCAL_HARNESS_HTTP_PORT=3000
