# Required. JSON is portable across Windows drive letters and Unix paths.
LOCAL_HARNESS_ROOTS=["C:\\Users\\you\\source","D:\\work"]

# Optional read-only memory root. Must be absolute and separate from workspace roots.
# When using Codex memory, only the canonical ~/.codex/memories path is accepted.
LOCAL_HARNESS_MEMORY_ROOT=

# Optional comma-separated additions to the default executable allowlist.
LOCAL_HARNESS_ALLOWED_COMMANDS=

# Optional comma-separated environment variable names forwarded to child processes.
LOCAL_HARNESS_ENV_ALLOWLIST=

# Optional limits.
LOCAL_HARNESS_DEFAULT_TIMEOUT_MS=120000
LOCAL_HARNESS_MAX_TIMEOUT_MS=300000
LOCAL_HARNESS_MAX_OUTPUT_BYTES=1048576
LOCAL_HARNESS_MAX_FILE_BYTES=1048576

# Optional audit log location. Defaults to the operating-system temp directory.
LOCAL_HARNESS_AUDIT_LOG=

# Disabled by default. Set true only when UNC roots are intentional.
LOCAL_HARNESS_ALLOW_UNC=false
