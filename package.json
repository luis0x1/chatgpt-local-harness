{
  "name": "chatgpt-local-harness",
  "version": "0.1.0",
  "description": "A security-conscious local coding MCP server for ChatGPT Work",
  "type": "module",
  "bin": {
    "chatgpt-local-harness": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    ".codex-plugin",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "minimatch": "10.2.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "22.20.3",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "license": "MIT",
  "private": true
}
